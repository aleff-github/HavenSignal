#!/bin/sh
set -eu

repository_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
secrets_directory="$repository_root/.docker/secrets"

create_secret() {
    secret_path=$1
    if [ ! -f "$secret_path" ]; then
        temporary_path="$secret_path.tmp.$$"
        umask 077
        od -An -N32 -tx1 /dev/urandom | tr -d ' \n' > "$temporary_path"
        mv "$temporary_path" "$secret_path"
    fi
    chmod 640 "$secret_path"
}

prepare_secrets() {
    mkdir -p "$secrets_directory"
    chmod 700 "$secrets_directory"
    create_secret "$secrets_directory/postgres_password"
    create_secret "$secrets_directory/django_secret_key"
}

run_postgresql_restart_probe() {
    restart_probe_project="havensignal-alpha-restart-probe-$$"
    restart_probe_id=$(tr -d '\n' < /proc/sys/kernel/random/uuid)

    restart_probe_compose() {
        HAVENSIGNAL_POSTGRES_PORT=0 HAVENSIGNAL_HTTP_PORT=0 \
            docker compose \
                --project-name "$restart_probe_project" \
                --profile test \
                "$@"
    }

    cleanup_restart_probe() {
        trap - EXIT INT TERM
        cleanup_status=0
        restart_probe_compose run --rm test \
            python -m tests.postgresql_restart_probe cleanup "$restart_probe_id" \
            || cleanup_status=$?
        restart_probe_compose down --volumes --remove-orphans \
            || cleanup_status=$?
        return "$cleanup_status"
    }

    trap cleanup_restart_probe EXIT INT TERM
    restart_probe_compose up --detach --wait postgres
    restart_probe_compose run --rm test python manage.py migrate --noinput
    restart_probe_compose run --rm test \
        python -m tests.postgresql_restart_probe prepare "$restart_probe_id"
    restart_probe_compose restart postgres
    restart_probe_compose up --detach --wait postgres
    restart_probe_compose run --rm test \
        python -m tests.postgresql_restart_probe verify "$restart_probe_id"
    cleanup_restart_probe
}

cd "$repository_root"
export HAVENSIGNAL_HOST_UID="$(id -u)"
export HAVENSIGNAL_HOST_GID="$(id -g)"

case "${1:-}" in
    up)
        prepare_secrets
        docker compose build web migrate
        docker compose up --detach postgres migrate web
        docker compose ps
        ;;
    test)
        prepare_secrets
        docker compose --profile test build test
        docker compose --profile test run --rm test
        run_postgresql_restart_probe
        ;;
    logs)
        docker compose logs --follow postgres web
        ;;
    ps)
        docker compose ps
        ;;
    down)
        docker compose down --remove-orphans
        ;;
    reset)
        docker compose down --volumes --remove-orphans
        ;;
    *)
        echo "usage: ./scripts/docker-local {up|test|logs|ps|down|reset}" >&2
        exit 2
        ;;
esac
